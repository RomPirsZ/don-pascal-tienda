---
// Chat «Pregúntale a Don Pascal» (spec §6, plan §6). Botón flotante y un <dialog> nativo (foco
// atrapado, Esc) que llena src/scripts/chat.ts, que se descarga al abrirlo por primera vez
// (constitución IV). Sin JS no aparece: la sección #pregunta ofrece WhatsApp.
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import { t } from '../i18n';
import { AVATAR } from '../lib/fotos';
import { NUMERO_TIENDA } from '../lib/whatsapp';

// Sin clave de sitio se usa la de prueba invisible de Cloudflare (pública): en desarrollo y en
// los e2e funciona; en producción el servidor la rechaza, así que la de verdad es obligatoria.
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000BB';
const ejemplos = [t('pregunta.ejemplo1'), t('pregunta.ejemplo2'), t('pregunta.ejemplo3')];
---

<button
  type="button"
  data-chat-abrir
  hidden
  class="sobre-monte fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 inline-flex items-center gap-3 rounded-full bg-monte p-1.5 font-semibold text-papel shadow-flotante transition-transform duration-150 active:scale-95 sm:pr-5"
>
  <Foto imagen={AVATAR} alt="" sizes="2.75rem" class="size-11 rounded-full bg-monte-claro object-cover" />
  <span class="sr-only sm:not-sr-only">{t('chat.abrir')}</span>
</button>

<dialog
  id="chat"
  aria-labelledby="chat-titulo"
  data-sitekey={sitekey}
  data-numero={NUMERO_TIENDA ?? ''}
  class="panel-chat m-0 h-dvh max-h-dvh w-full max-w-none overflow-hidden bg-superficie p-0 text-tinta backdrop:bg-tinta/50 sm:mt-auto sm:mr-4 sm:mb-4 sm:ml-auto sm:h-[min(42rem,calc(100dvh-2rem))] sm:w-[25rem] sm:rounded-tarjeta sm:shadow-flotante"
>
  <div class="flex h-full flex-col">
    <header class="sobre-monte flex items-center gap-3 bg-monte px-4 py-3 text-papel">
      <Foto imagen={AVATAR} alt="" sizes="2.75rem" class="size-11 shrink-0 rounded-full bg-monte-claro object-cover" />
      <div class="min-w-0 flex-1">
        <h2 id="chat-titulo" class="text-lg leading-tight font-bold">{t('chat.titulo')}</h2>
        <p class="text-sm text-sobre-monte-suave">{t('chat.subtitulo')}</p>
      </div>
      <button type="button" data-chat-cerrar class="grid size-11 place-items-center rounded-full hover:bg-monte-claro" aria-label={t('chat.cerrar')}>
        <Icono nombre="cerrar" class="size-6" />
      </button>
    </header>

    <div data-chat-desplazable class="flex-1 overflow-y-auto overscroll-contain px-4 py-4">
      <p class="mx-auto max-w-[36ch] text-center text-sm leading-snug text-tinta-suave">{t('chat.aviso')}</p>

      <ol data-chat-lista aria-label={t('chat.conversacion')} class="mt-4 flex flex-col gap-3">
        <li class="flex items-end gap-2">
          <img src="/img/avatar-96.webp" alt="" width="96" height="96" class="size-7 shrink-0 rounded-full bg-hoja object-cover" />
          <p class="max-w-[85%] rounded-tarjeta rounded-bl-md bg-papel px-4 py-2.5 shadow-tarjeta">{t('chat.saludo')}</p>
        </li>
      </ol>

      <ul data-chat-sugerencias aria-label={t('chat.sugerencias')} class="mt-3 ml-9 flex flex-col items-start gap-2">
        {
          ejemplos.map((e) => (
            <li>
              <button type="button" data-chat-sugerencia class="rounded-full bg-pradera px-4 py-2 text-left text-sm font-semibold text-monte hover:bg-hoja hover:text-tinta">
                {e}
              </button>
            </li>
          ))
        }
      </ul>

      <button type="button" data-chat-borrar hidden class="mx-auto mt-6 block py-2 text-sm font-semibold text-tinta-suave underline underline-offset-4">
        {t('chat.borrar')}
      </button>
    </div>

    <form data-chat-form class="bg-papel px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
      <!-- Turnstile: invisible salvo que Cloudflare necesite que la persona pulse algo -->
      <div data-chat-turnstile></div>
      <div class="flex items-center gap-2">
        <label for="chat-campo" class="sr-only">{t('chat.campo')}</label>
        <input
          id="chat-campo"
          name="pregunta"
          type="text"
          autocomplete="off"
          enterkeyhint="send"
          maxlength="600"
          required
          placeholder={t('chat.placeholder')}
          class="min-w-0 flex-1 rounded-full border border-tinta-suave bg-papel px-4 py-3 placeholder:text-tinta-suave"
        />
        <button type="submit" data-chat-enviar class="grid size-12 shrink-0 place-items-center rounded-full bg-maiz text-tinta aria-disabled:opacity-60" aria-label={t('chat.enviar')}>
          <Icono nombre="enviar" class="size-5" />
        </button>
      </div>
    </form>
  </div>
</dialog>

<template id="chat-mensaje-asistente">
  <li class="flex items-end gap-2">
    <img src="/img/avatar-96.webp" alt="" width="96" height="96" class="size-7 shrink-0 rounded-full bg-hoja object-cover" />
    <div class="flex max-w-[85%] flex-col items-start gap-2">
      <p data-texto class="rounded-tarjeta rounded-bl-md bg-papel px-4 py-2.5 wrap-anywhere whitespace-pre-line shadow-tarjeta"></p>
      <a data-whatsapp hidden class="inline-flex items-center gap-2 rounded-full bg-monte px-4 py-2 text-sm font-semibold text-papel no-underline">
        <Icono nombre="mensaje" class="size-4" />
        {t('chat.whatsapp')}
      </a>
    </div>
  </li>
</template>

<template id="chat-mensaje-cliente">
  <li class="flex justify-end">
    <p data-texto class="max-w-[85%] rounded-tarjeta rounded-br-md bg-monte px-4 py-2.5 wrap-anywhere whitespace-pre-line text-papel"></p>
  </li>
</template>

<template id="chat-escribiendo">
  <li class="flex items-end gap-2" data-chat-escribiendo>
    <img src="/img/avatar-96.webp" alt="" width="96" height="96" class="size-7 shrink-0 rounded-full bg-hoja object-cover" />
    <p class="rounded-tarjeta rounded-bl-md bg-papel px-4 py-2.5 text-sm text-tinta-suave italic shadow-tarjeta">{t('chat.escribiendo')}</p>
  </li>
</template>

<p data-chat-anuncio aria-live="polite" class="sr-only"></p>

<script>
  // Arranque mínimo: muestra los botones y descarga el chat la primera vez que se abre. Los
  // enlaces con data-chat-abrir (como «o pregúntale a Don Pascal») llevan a #pregunta sin JS.
  for (const boton of document.querySelectorAll<HTMLButtonElement>('button[data-chat-abrir]')) boton.hidden = false;
  let chat: Promise<typeof import('../scripts/chat')> | undefined;
  document.addEventListener('click', (evento) => {
    const disparador = (evento.target as Element).closest<HTMLElement>('[data-chat-abrir]');
    if (!disparador) return;
    evento.preventDefault();
    chat ??= import('../scripts/chat');
    chat.then((m) => m.abrirChat()).catch(() => {
      // Sin red para descargar el chat: la sección con WhatsApp
      chat = undefined;
      location.hash = '#pregunta';
    });
  });
</script>
