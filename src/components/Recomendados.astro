---
import Icono from './Icono.astro';
import TarjetaProducto from './TarjetaProducto.astro';
import { t } from '../i18n';
import type { Producto } from '../lib/catalogo';

interface Props {
  productos: Producto[];
  total: number;
  tasa: number;
}

const { productos, total, tasa } = Astro.props;
// «Ver todos» cierra la última fila en las tres rejillas (2, 3 y 4 columnas): ocupa lo que falta
// para completarla, o la fila entera si ya estaba completa. Clases literales para Tailwind.
const resto = (columnas: number) => columnas - (productos.length % columnas || columnas) || columnas;
const ANCHO: Record<string, Record<number, string>> = {
  base: { 1: 'col-span-1', 2: 'col-span-2' },
  md: { 1: 'md:col-span-1', 2: 'md:col-span-2', 3: 'md:col-span-3' },
  lg: { 1: 'lg:col-span-1', 2: 'lg:col-span-2', 3: 'lg:col-span-3', 4: 'lg:col-span-4' },
};
const anchoVerTodos = [ANCHO['base']![resto(2)], ANCHO['md']![resto(3)], ANCHO['lg']![resto(4)]];
---

<section class="contenedor py-16 lg:py-20" aria-labelledby="recomendados-titulo">
  <div data-revelar class="flex flex-wrap items-end justify-between gap-4">
    <h2 id="recomendados-titulo" class="text-titulo font-bold">{t('recomendados.titulo')}</h2>
    <a href="/productos/" class="inline-flex items-center gap-2 font-semibold text-hoja-texto no-underline hover:underline">
      {t('recomendados.todo', { n: String(total) })}
      <Icono nombre="flecha" class="size-5" />
    </a>
  </div>
  <ul data-revelar-lista class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
    {productos.map((p) => <li class="flex"><TarjetaProducto producto={p} tasa={tasa} /></li>)}
    {
      productos.length > 0 && (
        <li class:list={['flex', anchoVerTodos]}>
          <a
            href="/productos/"
            class="sobre-monte flex w-full flex-col justify-between gap-6 rounded-tarjeta bg-monte p-6 text-papel no-underline shadow-tarjeta transition-shadow duration-200 ease-suave hover:shadow-flotante"
          >
            <span class="text-subtitulo font-semibold">{t('recomendados.todo', { n: String(total) })}</span>
            <span class="grid size-12 place-items-center rounded-full bg-maiz text-tinta"><Icono nombre="flecha" class="size-6" /></span>
          </a>
        </li>
      )
    }
  </ul>
</section>
