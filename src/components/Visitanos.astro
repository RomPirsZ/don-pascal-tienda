---
import Icono from './Icono.astro';
import { t } from '../i18n';
import type { Ajustes } from '../lib/catalogo';

interface Props {
  ajustes: Ajustes;
}

const { ajustes } = Astro.props;
---

<section class="contenedor py-16 lg:py-20" aria-labelledby="visitanos-titulo">
  <h2 id="visitanos-titulo" class="text-titulo font-bold">{t('visitanos.titulo')}</h2>
  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    <div class="flex gap-4 rounded-tarjeta bg-superficie p-6">
      <span class="grid size-12 shrink-0 place-items-center rounded-full bg-maiz text-tinta"><Icono nombre="reloj" class="size-6" /></span>
      <div>
        <h3 class="font-semibold">{t('visitanos.horario')}</h3>
        <p class="mt-1">{ajustes.horario}</p>
      </div>
    </div>
    <div class="flex gap-4 rounded-tarjeta bg-superficie p-6">
      <span class="grid size-12 shrink-0 place-items-center rounded-full bg-hoja text-tinta"><Icono nombre="ubicacion" class="size-6" /></span>
      <div>
        <h3 class="font-semibold">{t('visitanos.direccion')}</h3>
        <p class="mt-1">{ajustes.direccion}</p>
      </div>
    </div>
  </div>
</section>
