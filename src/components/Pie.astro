---
import { t } from '../i18n';
import type { Ajustes } from '../lib/catalogo';
import { formatoBs } from '../lib/precios';

interface Props {
  ajustes?: Ajustes | undefined;
}

const { ajustes } = Astro.props;
const [anio, mes, dia] = (ajustes?.tasaFecha ?? '').split('-');
---

<footer class="sobre-monte bg-monte pt-12 pb-24 text-papel">
  <div class="contenedor grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-12">
    <div>
      <p class="text-2xl font-bold">{t('sitio.nombre')}</p>
      <p class="mt-2 text-sobre-monte-suave">{t('pie.lema')}</p>
    </div>
    <!-- Medida de lectura (revisión de Taste en E15): el texto legal no pasa de ~65 caracteres -->
    <div class="max-w-[65ch] space-y-2 text-sm text-sobre-monte-suave">
      <p>{t('pie.concepto')}</p>
      <p>{t('pie.creditos')}</p>
      {ajustes && <p class="precio">{t('pie.tasa', { tasa: formatoBs(Math.round(ajustes.tasaBcv * 100)), fecha: `${dia}/${mes}/${anio}` })}</p>}
      <p>
        © {new Date().getFullYear()} ·{' '}
        <a href="https://ankordev-portafolio.ankordev.workers.dev/" class="font-semibold text-papel">{t('pie.ankordev')}</a>
      </p>
    </div>
  </div>
</footer>
