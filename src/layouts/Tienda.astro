---
// Página de la tienda: cabecera, contenido y pie. Si el catálogo no cargó, muestra el aviso.
import Base from './Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Carrito from '../components/Carrito.astro';
import Chat from '../components/Chat.astro';
import Pie from '../components/Pie.astro';
import { t } from '../i18n';
import type { Catalogo } from '../lib/catalogo';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** undefined si no se pudo leer: la página muestra el aviso en lugar del contenido */
  catalogo: Catalogo | undefined;
}

const { catalogo, ...base } = Astro.props;
---

<Base {...base}>
  <Cabecera />
  <main id="contenido" class="flex flex-1 flex-col">
    {catalogo ? <slot /> : <p class="contenedor py-24 text-lg">{t('catalogo.error')}</p>}
  </main>
  <Pie ajustes={catalogo?.ajustes} />
  {catalogo && <Carrito catalogo={catalogo} />}
  {catalogo && <Chat />}
</Base>

<script>
  import { iniciarMovimiento } from '../scripts/movimiento';
  iniciarMovimiento();
</script>
