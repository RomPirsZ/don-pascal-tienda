---
import '@fontsource/poppins/latin-300.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '../styles/global.css';
// Las cuatro de Poppins se usan en la primera pantalla (hero 700 y 300, texto 400, cabecera 600):
// se precargan para que lleguen antes de pintar y la página no salte al cambiar de fuente (CLS,
// E16; como el portafolio en T33). Son los mismos archivos que importa @fontsource.
import poppins300 from '@fontsource/poppins/files/poppins-latin-300-normal.woff2?url';
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppins600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import { t } from '../i18n';
import { IMAGEN_OG, SITE_URL } from '../lib/sitio';

interface Props {
  title?: string;
  description?: string;
  /** Páginas que no deben indexarse (404) */
  noindex?: boolean;
}

const { title = t('sitio.titulo'), description = t('sitio.descripcion'), noindex = false } = Astro.props;
// Canonical y vista previa al compartir (E17, spec §9): siempre con la URL pública, sin parámetros
const sitio = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, sitio).href;
const imagenOg = new URL(IMAGEN_OG.ruta, sitio).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {[poppins400, poppins700, poppins300, poppins600].map((url) => <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />)}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('sitio.nombre')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:type" content={IMAGEN_OG.tipo} />
    <meta property="og:image:width" content={String(IMAGEN_OG.ancho)} />
    <meta property="og:image:height" content={String(IMAGEN_OG.alto)} />
    <meta property="og:image:alt" content={t('sitio.og-alt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenOg} />
    <!-- Recortados de la ilustración de Don Pascal (src/assets/don-pascal/medio-cuerpo.png) -->
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- El color del monte: la barra del navegador móvil continúa la cabecera -->
    <meta name="theme-color" content="rgb(30 77 58)" />
    <meta name="color-scheme" content="only light" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-maiz focus:px-5 focus:py-2 focus:font-semibold focus:text-tinta"
      >{t('nav.saltar')}</a
    >
    <slot />
  </body>
</html>
