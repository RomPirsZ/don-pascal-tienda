---
// Inicio (spec §5, contrato en .impeccable/surfaces/src-pages-index-astro.md). Se genera en
// cada petición para mostrar los precios vigentes (plan §4).
import Tienda from '../layouts/Tienda.astro';
import AlMayor from '../components/AlMayor.astro';
import Categorias from '../components/Categorias.astro';
import ComoPedir from '../components/ComoPedir.astro';
import Hero from '../components/Hero.astro';
import Ofertas from '../components/Ofertas.astro';
import Pregunta from '../components/Pregunta.astro';
import Recomendados from '../components/Recomendados.astro';
import Visitanos from '../components/Visitanos.astro';
import { catalogoDelServidor } from '../lib/catalogo-servidor';
import { ahorroMayor } from '../lib/precios';

export const prerender = false;

const catalogo = await catalogoDelServidor();
if (!catalogo) Astro.response.status = 503;

const disponibles = catalogo?.productos.filter((p) => p.disponible) ?? [];
---

<Tienda ajustes={catalogo?.ajustes} sinCatalogo={!catalogo}>
    {
      catalogo && (
        <>
          <Hero categorias={catalogo.categorias} tasa={catalogo.ajustes.tasaBcv} />
          <Ofertas productos={disponibles.filter((p) => p.ofertaPct).slice(0, 4)} tasa={catalogo.ajustes.tasaBcv} />
          <Categorias categorias={catalogo.categorias} productos={disponibles} />
          <Recomendados productos={disponibles.filter((p) => p.destacado).slice(0, 8)} total={disponibles.length} tasa={catalogo.ajustes.tasaBcv} />
          <AlMayor productos={disponibles.filter((p) => ahorroMayor(p) > 0).slice(0, 6)} />
          <ComoPedir />
          <Pregunta />
          <Visitanos ajustes={catalogo.ajustes} />
        </>
      )
    }
</Tienda>
