---
import { t } from '../i18n';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{t('404.titulo')} · {t('sitio.nombre')}</title>
  </head>
  <body>
    <main>
      <h1>{t('404.titulo')}</h1>
      <p>{t('404.texto')}</p>
      <a href="/">{t('404.volver')}</a>
    </main>
  </body>
</html>
