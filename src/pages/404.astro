---
// 404 (E15): la tienda completa (cabecera con el carrito, chat y pie) para que nadie se quede sin
// salida, con el buscador y Don Pascal. Se genera en el Worker para tener el catálogo; si no se
// puede leer, el layout muestra su aviso.
import Tienda from '../layouts/Tienda.astro';
import Buscador from '../components/Buscador.astro';
import Foto from '../components/Foto.astro';
import { t } from '../i18n';
import { catalogoDelServidor } from '../lib/catalogo-servidor';
import { DON_PASCAL } from '../lib/fotos';

export const prerender = false;

const catalogo = await catalogoDelServidor();
Astro.response.status = 404;
---

<Tienda title={`${t('404.titulo')} · ${t('sitio.nombre')}`} noindex catalogo={catalogo}>
  <!-- Desde lg, dos columnas y Don Pascal de pie sobre el pie de página: su arco nace del borde
       de la sección, como en el hero, y nunca queda cortado en mitad del blanco -->
  <section class="contenedor grid grid-cols-[minmax(0,1fr)] gap-10 pt-16 pb-16 lg:flex-1 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:pb-0" aria-labelledby="no-existe-titulo">
    <div class="lg:self-center lg:pb-16">
      <h1 id="no-existe-titulo" class="text-titulo font-bold">{t('404.titulo')}</h1>
      <p class="mt-4 max-w-[36rem] text-lg">{t('404.texto')}</p>
      {catalogo && (
        <div class="mt-8">
          <Buscador categorias={catalogo.categorias} />
        </div>
      )}
      <a href="/" class="mt-6 inline-flex rounded-full bg-maiz px-6 py-3 font-semibold text-tinta no-underline">{t('404.volver')}</a>
    </div>
    <!-- Don Pascal sobre su arco, como en el inicio, sin insignias -->
    <div class="relative mx-auto w-full max-w-[18rem] self-end max-lg:hidden" aria-hidden="true">
      <div class="absolute inset-x-[6%] top-[12%] bottom-0 rounded-t-full bg-pradera"></div>
      <Foto imagen={DON_PASCAL} alt="" sizes="16rem" class="relative mx-auto h-[24rem] w-auto object-contain object-top" />
    </div>
  </section>
</Tienda>
