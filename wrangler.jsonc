// Cloudflare Workers (plan §2). El adaptador de Astro completa el resto: el directorio del
// build estático y, cuando haya rutas de servidor, `main` y `ASSETS`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "don-pascal",
  // Fecha fija: el comportamiento del runtime no cambia sin decidirlo
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  // Logs del Worker (solo códigos y eventos, nunca lo que escribe el cliente) sin los de
  // invocación, que guardan la URL, las cabeceras y la IP de cada petición
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
  // Sin `assets.not_found_handling`: con él, las navegaciones que no coinciden con un archivo
  // estático reciben la página 404 sin llegar al Worker, y el inicio y el catálogo se generan
  // en el Worker (plan §4). Las rutas que no existen las responde Astro con su 404.
}
